#!/bin/sh
# DreamFinder — PR-only guard for `main`.
#
# Direct pushes to main bypass review and the required pull-request check.
# Refuse every local push whose destination is main; push a feature branch and
# merge it through a pull request instead. Server-side branch protection is
# the authoritative control. This hook provides an earlier local explanation.
#
# Triggered by git as: .git/hooks/pre-push <remote-name> <remote-url>
# Receives one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
#
set -u

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Only guard pushes whose destination is main.
    [ "$remote_ref" = "refs/heads/main" ] || continue

    echo "" >&2
    echo "[pre-push] REFUSED: direct pushes to main are disabled." >&2
    echo "" >&2
    echo "  Push a feature branch and merge it through a pull request:" >&2
    echo "" >&2
    echo "    git push -u origin HEAD" >&2
    echo "    gh pr create --base main" >&2
    echo "" >&2
    echo "  Required check: Full suite (18 checks)" >&2
    echo "  Deployment guide: docs/deployment-workflow.md" >&2
    echo "" >&2
    status=1
done

exit $status
